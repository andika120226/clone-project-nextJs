generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  FARMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole
  phone        String?
  gender       String?
  birthDate    DateTime?
  image        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addresses    Address[]
  bankAccounts BankAccount[]
  products     Product[]
  orders       Order[]       @relation("CustomerOrders")
  soldOrders   Order[]       @relation("FarmerOrders")
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String
  recipientName String
  phoneNumber   String
  fullAddress   String
  city          String
  province      String
  isMain        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId])
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankName      String
  accountNumber String
  accountHolder String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerOrders Order[] @relation("OrderCustomerBank")
  farmerOrders   Order[] @relation("OrderFarmerBank")

  @@index([userId])
  @@unique([userId, accountNumber])
}

model Product {
  id          String      @id @default(cuid())
  farmerId    String
  name        String
  description String?
  pricePerKg  Decimal     @db.Decimal(12, 2)
  stockKg     Int
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  farmer      User        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]

  @@index([farmerId])
}

model LogisticsVehicle {
  id          String   @id @default(cuid())
  name        String
  vehicleType String
  capacityTon Decimal  @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                    String            @id @default(cuid())
  trackingId            String            @unique
  customerId            String
  farmerId              String
  logisticsVehicleId    String?
  customerBankAccountId String?
  farmerBankAccountId   String?
  addressId             String?
  status                OrderStatus       @default(PENDING)
  subtotal              Decimal           @db.Decimal(14, 2)
  logisticsCost         Decimal           @db.Decimal(14, 2) @default(0)
  total                 Decimal           @db.Decimal(14, 2)
  currentLat            Float?
  currentLng            Float?
  estimatedArrival      DateTime?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  customer              User              @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  farmer                User              @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Cascade)
  logisticsVehicle      LogisticsVehicle? @relation(fields: [logisticsVehicleId], references: [id], onDelete: SetNull)
  customerBankAccount   BankAccount?      @relation("OrderCustomerBank", fields: [customerBankAccountId], references: [id], onDelete: SetNull)
  farmerBankAccount     BankAccount?      @relation("OrderFarmerBank", fields: [farmerBankAccountId], references: [id], onDelete: SetNull)
  address               Address?          @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  trackingPoints        TrackingPoint[]

  @@index([customerId])
  @@index([farmerId])
  @@index([trackingId])
  @@index([status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantityKg Int
  unitPrice Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model TrackingPoint {
  id        String   @id @default(cuid())
  orderId   String
  latitude  Float
  longitude Float
  note      String?
  recordedAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, recordedAt])
}

model PartnershipInquiry {
  id           String   @id @default(cuid())
  name         String
  phone        String
  role         String
  landArea     String?
  location     String?
  monthlyNeeds String?
  commodity    String?
  notes        String?
  status       String   @default("NEW")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
